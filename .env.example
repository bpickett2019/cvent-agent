# Copy to .env for local development. Never commit real values.
ANTHROPIC_API_KEY=
EMERALDX_MODEL_ID=
EMERALDX_OPERATOR=
EMERALDX_ENTRA_TENANT_ID=
EMERALDX_ENTRA_CLIENT_ID=
EMERALDX_ENTRA_CLIENT_SECRET=
EMERALDX_AUTH_BASE_URL=http://localhost:3000
EMERALDX_ENTRA_REDIRECT_PROXY_URL=
EMERALDX_ENTRA_OPERATOR_EMAILS=
AUTH_SECRET=
# Local development only. Production ignores this bypass and fails closed.
EMERALDX_ALLOW_UNAUTHENTICATED_DEV=false
EMERALDX_RUN_ID=
EMERALDX_QUEUE_DIR=.queue
EMERALDX_RUN_DIR=.runs
EMERALDX_ASSET_DIR=.assets
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
DATABASE_URL=
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_STORAGE_ACCOUNT=
AZURE_KEY_VAULT_URL=
CVENT_API_BASE_URL=
CVENT_CLIENT_ID=
CVENT_CLIENT_SECRET=
STEEL_API_KEY=
STEEL_BASE_URL=
# Langfuse Cloud region or self-hosted base URL, e.g. https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
