# Install as /etc/cvent-agent/cvent-agent.env with mode 0600.
# Supply values through an approved secret channel. Never commit populated values.
CVENT_CLIENT_ID=
CVENT_CLIENT_SECRET=
CVENT_API_BASE_URL=https://api-platform.cvent.com/ea
STEEL_BASE_URL=http://127.0.0.1:3300
# Replace the placeholder with the same reviewed immutable digest passed to
# bootstrap-pilot.sh as STEEL_IMAGE. A tag or unreviewed digest is not acceptable.
STEEL_WORKSPACE_IMAGE=ghcr.io/steel-dev/steel-browser@sha256:<reviewed-64-hex-digest>
EMERALDX_STEEL_WORKSPACE_MODE=containers
EMERALDX_AUTOSTART_WORKER=true
EMERALDX_WORKSPACE_DIR=/var/lib/cvent-agent/workspaces
EMERALDX_QUEUE_DIR=/var/lib/cvent-agent/queue
EMERALDX_RUN_DIR=/var/lib/cvent-agent/runs
EMERALDX_ASSET_DIR=/var/lib/cvent-agent/assets
EMERALDX_SESSION_PATH=/var/lib/cvent-agent/session.json
EMERALDX_AUTHORIZATION_PATH=/etc/cvent-agent/authorizations.json
# Required by the production web proxy. Generate and deliver the password via
# an approved secret channel; never reuse the Cvent account credentials.
EMERALDX_OPERATOR_AUTH_USERNAME=
EMERALDX_OPERATOR_AUTH_PASSWORD=
CVENT_GOLDEN_USER_DATA_DIR=/profiles/cvent-golden
# PI/model/Langfuse values required by the reviewed environment belong below.
