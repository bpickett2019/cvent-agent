[Unit]
Description=Emerald CVENT Agent Pilot
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=cventagent
Group=cventagent
SupplementaryGroups=docker
WorkingDirectory=/opt/cvent-agent/source/web
Environment=NODE_ENV=production
EnvironmentFile=/etc/cvent-agent/cvent-agent.env
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 4320
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cvent-agent /opt/cvent-agent/source/.queue /opt/cvent-agent/source/.runs /opt/cvent-agent/source/.workspaces
UMask=0077

[Install]
WantedBy=multi-user.target
